{
  "name": "typeqlite-vscode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vscode/src",
  "projectType": "application",
  "tags": [
    "scope:tooling",
    "type:app"
  ],
  "targets": {
    "sync-grammar": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typeqlite-language:langium-generate"
      ],
      "options": {
        "command": "node ../../tools/copy-file.mjs ../../libs/language/syntaxes/typeqlite.tmLanguage.json syntaxes/typeqlite.tmLanguage.json",
        "cwd": "apps/vscode"
      },
      "outputs": [
        "{projectRoot}/syntaxes"
      ]
    },
    "sync-icon": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/docs/brand/typedblite-icon-512.png"
      ],
      "options": {
        "command": "node ../../tools/copy-file.mjs ../../docs/brand/typedblite-icon-512.png images/icon.png && node ../../tools/copy-file.mjs ../../docs/brand/typedblite-icon-512.png theme-bridge/images/icon.png",
        "cwd": "apps/vscode"
      },
      "outputs": [
        "{projectRoot}/images",
        "{projectRoot}/theme-bridge/images"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "sync-grammar",
        "sync-icon",
        "^build"
      ],
      "options": {
        "command": "node esbuild.mjs",
        "cwd": "apps/vscode"
      },
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "apps/vscode"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "apps/vscode"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "package"
      ],
      "options": {
        "command": "node esbuild.e2e.mjs && node e2e/out/run.cjs dist/typeqlite-0.0.1.vsix dist/typeqlite-theme-0.0.1.vsix",
        "cwd": "apps/vscode"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "sync-grammar",
        "sync-icon",
        "^build"
      ],
      "options": {
        "commands": [
          "node esbuild.mjs --minify",
          "mkdir -p dist",
          "cp ../../LICENSE LICENSE",
          "vsce package --no-dependencies --out dist/typeqlite-0.0.1.vsix",
          "node ../../tools/copy-file.mjs ../../LICENSE theme-bridge/LICENSE",
          "cd theme-bridge && vsce package --no-dependencies --out ../dist/typeqlite-theme-0.0.1.vsix"
        ],
        "parallel": false,
        "cwd": "apps/vscode"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
