{
  "name": "typeqlite",
  "displayName": "TypeQLite",
  "description": "TypeQLite language support from TypeDBLite: diagnostics, formatting and semantic highlighting",
  "icon": "images/icon.png",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "publisher": "typedblite",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dave-jackson-dev/typedblite.git",
    "directory": "apps/vscode"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onLanguage:typeqlite"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typeqlite",
        "aliases": [
          "TypeQLite",
          "typeqlite"
        ],
        "extensions": [
          ".typeqlite",
          ".tql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typeqlite",
        "scopeName": "source.typeqlite",
        "path": "./syntaxes/typeqlite.tmLanguage.json"
      },
      {
        "scopeName": "markdown.typeqlite.codeblock",
        "path": "./grammars/typeqlite-markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.typeqlite": "typeqlite"
        }
      }
    ],
    "markdown.markdownItPlugins": true
  },
  "vsce": {
    "dependencies": false
  },
  "dependencies": {
    "@typedblite/language": "*",
    "jsonc-parser": "~3.3.1",
    "langium": "~4.4.2",
    "vscode-languageclient": "~10.0.0",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "~14.1.2",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "~3.1.0",
    "@vscode/vsce": "~3.9.2",
    "esbuild": "~0.28.1",
    "markdown-it": "~14.3.3",
    "vscode-jsonrpc": "~9.0.0"
  }
}
