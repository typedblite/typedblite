{
  "name": "typedblite-workbench",
  "displayName": "TypeDBLite",
  "description": "TypeQLite editor, notebooks and debugger for TypeDBLite, the embedded graph database",
  "icon": "images/icon.png",
  "version": "0.3.2",
  "license": "MPL-2.0",
  "publisher": "typedblite",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/typedblite/typedblite.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://github.com/typedblite/typedblite/tree/main/apps/vscode#readme",
  "bugs": {
    "url": "https://github.com/typedblite/typedblite/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "typeqlite",
    "typeql",
    "typedb",
    "typedblite",
    "sqlite",
    "graph",
    "database",
    "schema",
    "langium"
  ],
  "galleryBanner": {
    "color": "#15171C",
    "theme": "dark"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onNotebook:typeqlite-notebook",
    "onNotebook:typeqlite-notebook-markdown",
    "onDebugResolve:typeqlite",
    "onDebugDynamicConfigurations:typeqlite"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "typeqlite"
      }
    ],
    "debuggers": [
      {
        "type": "typeqlite",
        "label": "TypeQLite",
        "languages": [
          "typeqlite"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .tql or .typeqlite file to run, statement by statement, in a fresh in-memory store.",
                "default": "${file}"
              },
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files of define statements, run first, in this order. Relative to cwd.",
                "default": []
              },
              "seed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files of data, run after the schema, in this order. Relative to cwd.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The folder schema and seed paths are relative to. The program's own folder when not given.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement, before it runs.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "typeqlite",
            "request": "launch",
            "name": "Debug TypeQLite file",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "schema": [],
            "seed": [],
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "TypeQLite: Debug a file",
            "description": "Run a TypeQLite file under the debugger, in a fresh in-memory store.",
            "body": {
              "type": "typeqlite",
              "request": "launch",
              "name": "Debug TypeQLite file",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "schema": [],
              "seed": [],
              "stopOnEntry": true
            }
          },
          {
            "label": "TypeQLite: Debug with a schema and seed data",
            "description": "Run the schema and seed files first, then debug the program.",
            "body": {
              "type": "typeqlite",
              "request": "launch",
              "name": "Debug TypeQLite with data",
              "program": "^\"\\${workspaceFolder}/${1:program.tql}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "schema": [
                "${2:schema.tql}"
              ],
              "seed": [
                "${3:seed.tql}"
              ],
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "typeqlite",
        "aliases": [
          "TypeQLite",
          "typeqlite"
        ],
        "extensions": [
          ".typeqlite",
          ".tql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/typeqlite-file.svg",
          "dark": "./images/typeqlite-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "typeqlite",
        "scopeName": "source.typeqlite",
        "path": "./syntaxes/typeqlite.tmLanguage.json"
      },
      {
        "scopeName": "markdown.typeqlite.codeblock",
        "path": "./grammars/typeqlite-markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.typeqlite": "typeqlite"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "typedblite.host.request",
        "title": "TypeDBLite: Run an engine host operation",
        "category": "TypeDBLite"
      },
      {
        "command": "typedblite.notebook.restart",
        "title": "Restart the Notebook's Store",
        "category": "TypeQLite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "typedblite.notebook.openStore",
        "title": "Choose the Notebook's Store\u2026",
        "category": "TypeQLite",
        "icon": "$(database)"
      },
      {
        "command": "typedblite.notebook.commit",
        "title": "Commit the Notebook's Changes",
        "category": "TypeQLite",
        "icon": "$(check)"
      },
      {
        "command": "typedblite.notebook.rollback",
        "title": "Roll Back the Notebook's Changes",
        "category": "TypeQLite",
        "icon": "$(discard)"
      },
      {
        "command": "typedblite.notebook.exportScript",
        "title": "Export the Notebook as a TypeQLite Script\u2026",
        "category": "TypeQLite"
      },
      {
        "command": "typedblite.notebook.exportMarkdown",
        "title": "Export the Notebook as Markdown\u2026",
        "category": "TypeQLite"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "typedblite.host.request",
          "when": "false"
        },
        {
          "command": "typedblite.notebook.restart",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'"
        },
        {
          "command": "typedblite.notebook.openStore",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'"
        },
        {
          "command": "typedblite.notebook.exportScript",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'"
        },
        {
          "command": "typedblite.notebook.exportMarkdown",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'"
        },
        {
          "command": "typedblite.notebook.commit",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown' && typedblite.notebook.holdsChanges"
        },
        {
          "command": "typedblite.notebook.rollback",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown' && typedblite.notebook.holdsChanges"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "typedblite.notebook.restart",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'",
          "group": "navigation@1"
        },
        {
          "command": "typedblite.notebook.openStore",
          "when": "notebookType == 'typeqlite-notebook' || notebookType == 'typeqlite-notebook-markdown'",
          "group": "navigation@2"
        },
        {
          "command": "typedblite.notebook.commit",
          "when": "typedblite.notebook.holdsChanges",
          "group": "navigation@3"
        },
        {
          "command": "typedblite.notebook.rollback",
          "when": "typedblite.notebook.holdsChanges",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "TypeDBLite",
      "properties": {
        "typedblite.host.node": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `node` that runs the TypeDBLite engine host: a path, or empty for the one on PATH. It must be Node 22.16 or newer, which has `node:sqlite`."
        },
        "typedblite.notebook.maxRows": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "scope": "window",
          "markdownDescription": "How many rows of an answer a notebook cell shows. The rest are counted, never dropped silently."
        }
      }
    },
    "notebooks": [
      {
        "type": "typeqlite-notebook",
        "displayName": "TypeQLite Notebook",
        "selector": [
          {
            "filenamePattern": "*.tql.md"
          }
        ],
        "priority": "default"
      },
      {
        "type": "typeqlite-notebook-markdown",
        "displayName": "TypeQLite Notebook (any Markdown file)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "vsce": {
    "dependencies": false
  },
  "dependencies": {
    "@devx-micro/app-sidecar": "0.4.1",
    "@typedblite/debugger": "*",
    "@typedblite/language": "*",
    "@typedblite/notebook": "*",
    "jsonc-parser": "~3.3.1",
    "langium": "~4.4.2",
    "vscode-languageclient": "~10.0.0",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "~14.1.2",
    "@types/vscode": "~1.146.0",
    "@vscode/debugadapter-testsupport": "1.68.0",
    "@vscode/test-electron": "~3.1.0",
    "@vscode/vsce": "~3.9.2",
    "esbuild": "~0.28.1",
    "markdown-it": "~14.3.3",
    "vscode-jsonrpc": "~9.0.0"
  }
}
