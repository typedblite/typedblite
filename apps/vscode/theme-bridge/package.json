{
  "name": "typeqlite-theme",
  "displayName": "TypeQLite Theme Bridge",
  "description": "Lets the TypeDBLite extension color Markdown previews in your color theme in remote windows: WSL, SSH and containers",
  "icon": "images/icon.png",
  "version": "0.3.1",
  "license": "MPL-2.0",
  "publisher": "typedblite",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/typedblite/typedblite.git",
    "directory": "apps/vscode/theme-bridge"
  },
  "homepage": "https://github.com/typedblite/typedblite/tree/main/apps/vscode/theme-bridge#readme",
  "bugs": {
    "url": "https://github.com/typedblite/typedblite/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "typeqlite",
    "typedblite",
    "markdown",
    "theme",
    "remote",
    "wsl"
  ],
  "galleryBanner": {
    "color": "#15171C",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onCommand:typeqlite.themeFiles"
  ],
  "vsce": {
    "dependencies": false
  }
}
