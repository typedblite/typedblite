{
  "name": "sync-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sync-demo/src",
  "projectType": "application",
  "tags": ["scope:demo", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": ["tsc -b tsconfig.app.json"],
        "parallel": false,
        "cwd": "apps/sync-demo"
      },
      "outputs": ["{projectRoot}/out", "{projectRoot}/.build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": ["tsc -p tsconfig.app.json --noEmit"],
        "cwd": "apps/sync-demo"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitest run",
        "cwd": "apps/sync-demo"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitest run test/smoke.test.ts",
        "cwd": "apps/sync-demo"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node out/server/main.js",
        "cwd": "apps/sync-demo"
      }
    }
  }
}
