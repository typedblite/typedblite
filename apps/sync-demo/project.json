{
  "name": "sync-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sync-demo/src",
  "projectType": "application",
  "tags": [
    "scope:demo",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc -b tsconfig.app.json",
          "node build-client.mjs"
        ],
        "parallel": false,
        "cwd": "apps/sync-demo"
      },
      "outputs": [
        "{projectRoot}/out",
        "{projectRoot}/.build"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.client.json",
          "tsc -p tsconfig.worker.json",
          "tsc -p tsconfig.electron.json"
        ],
        "cwd": "apps/sync-demo",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "build-browser"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "apps/sync-demo"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run test/smoke.test.ts",
        "cwd": "apps/sync-demo"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node out/server/main.js",
        "cwd": "apps/sync-demo"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "build-browser"
      ],
      "options": {
        "command": "vitest run --config vitest.browser.config.ts",
        "cwd": "apps/sync-demo"
      }
    },
    "android-setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash mobile/setup.sh",
        "cwd": "apps/sync-demo"
      }
    },
    "android-apk": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash mobile/build-apk.sh",
        "cwd": "apps/sync-demo"
      },
      "outputs": [
        "{projectRoot}/mobile/android/app/build/outputs"
      ]
    },
    "android-emulator": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash mobile/start-emulator.sh",
        "cwd": "apps/sync-demo"
      }
    },
    "demo": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node out/driver/demo.js",
        "cwd": "apps/sync-demo"
      }
    },
    "browser-hub": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-browser"
      ],
      "options": {
        "command": "node out/browser-hub/serve.js",
        "cwd": "apps/sync-demo"
      }
    },
    "build-browser": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc -b tsconfig.app.json",
          "node build-browser-hub.mjs"
        ],
        "parallel": false,
        "cwd": "apps/sync-demo"
      },
      "outputs": [
        "{projectRoot}/.build-browser",
        "{projectRoot}/out"
      ]
    },
    "test-browser-hub": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-browser"
      ],
      "options": {
        "command": "vitest run --config vitest.browser.config.ts test-browser/browser-hub.test.ts",
        "cwd": "apps/sync-demo"
      }
    }
  }
}
