---
/**
 * Starlight's sidebar, with one change: an API reference group (the section, a package, a nested module, a category) gets an "Overview" entry
 * first, linking to the group's own index page when it has one (`src/content/docs/api/**\/index.md`: TypeDoc writes one for the overview, each
 * package and each module, and the site plugin writes one for each category). Starlight's groups are bare `<details>` with no link, so the overview pages were reachable only from the page body.
 * The group's label still only opens and closes it.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
// The loader's id for an `index.md` is its directory's (`api/typedblite/runtime`, `@` already dropped).
const indexes = docs.filter((d) => d.filePath?.startsWith('src/content/docs/api/') && d.filePath.endsWith('/index.md')).map((d) => d.id);
// The sidebar's group labels, in nesting order, map to the page's path: `API reference` → /api/, `@typedblite/runtime` → /api/typedblite/runtime/,
// then `wasm` under it → /api/typedblite/runtime/wasm/. A category (`Interfaces`, `Type Aliases`…) is the folder of its name, and its listing page is written by the TypeDoc site plugin.
const pages = Object.fromEntries(indexes.map((id) => [id, `/${id}/`]));
---

<Default {...Astro.props}><slot /></Default>

<script is:inline define:vars={{ pages }}>
  (() => {
    const root = document.querySelector('ul.top-level');
    const link = root?.querySelector('li > a');
    if (!link) return;
    const template = { item: link.parentElement, link };
    // `segs` is the labels of the API groups above (`API reference` itself is not one): /api/<package>/<module>.
    const walk = (list, segs, inApi) => {
      for (const li of list.children) {
        const details = li.querySelector(':scope > details');
        if (!details) continue;
        const label = details.querySelector(':scope > summary .large');
        const text = label?.textContent?.trim() ?? '';
        const isRoot = !inApi && text === 'API reference';
        const here = isRoot ? [] : inApi ? [...segs, text] : segs;
        const key = isRoot || inApi ? ['api', ...here].join('/').replace(/@/g, '').replace(/ /g, '-').toLowerCase() : undefined;
        const href = key && pages[key];
        const sub = details.querySelector(':scope > ul');
        // A category's folder already lists its own index page (the site plugin names it "Overview"); the others do not.
        if (href && sub && !sub.querySelector(`:scope > li > a[href="${href}"]`)) {
          // An "Overview" entry first in the group, made from a link and an item the sidebar already has so it is styled the same.
          const li = template.item.cloneNode(false);
          const a = template.link.cloneNode(true);
          a.href = href;
          a.removeAttribute('aria-current');
          a.querySelector('span').textContent = 'Overview';
          if (location.pathname.replace(/\/$/, '') === href.replace(/\/$/, '')) {
            a.setAttribute('aria-current', 'page');
            details.open = true;
          }
          li.appendChild(a);
          sub.prepend(li);
        }
        if (sub) walk(sub, here, inApi || isRoot);
      }
    };
    walk(root, [], false);
  })();
</script>
