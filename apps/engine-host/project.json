{
  "name": "engine-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/engine-host/src",
  "projectType": "application",
  "tags": [
    "scope:tooling",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc -b tsconfig.app.json && node ../../tools/make-executable.mjs out/main.js",
        "cwd": "apps/engine-host"
      },
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node esbuild.mjs",
        "cwd": "apps/engine-host"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "build",
        "bundle"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "apps/engine-host"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "cwd": "apps/engine-host",
        "parallel": true
      }
    }
  }
}
