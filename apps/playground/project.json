{
  "name": "playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground/src",
  "projectType": "application",
  "tags": ["scope:tooling", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": ["tsc -b tsconfig.app.json", "node build.mjs"],
        "parallel": false,
        "cwd": "apps/playground"
      },
      "outputs": ["{projectRoot}/out", "{projectRoot}/.build"]
    },
    "watch": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "command": "node watch.mjs", "cwd": "apps/playground" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "options": {
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.client.json", "tsc -p tsconfig.worker.json"],
        "parallel": false,
        "cwd": "apps/playground"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck", "build"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "command": "vitest run", "cwd": "apps/playground" }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "vitest run --config vitest.browser.config.ts", "cwd": "apps/playground" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node out/dev/serve.js", "cwd": "apps/playground" }
    }
  }
}
