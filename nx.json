{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "release": {
    "projects": [
      "content-revision",
      "typeqlite-language",
      "typedblite-runtime",
      "typedblite-session",
      "typedblite"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "currentVersionResolver": "disk",
      "versionPrefix": "",
      "preVersionCommand": "npm run build && npm run check-packages",
      "git": {
        "commit": true,
        "commitMessage": "chore(release): v{version}",
        "tag": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    }
  },
  "targetDefaults": {
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "test": {
      "dependsOn": [
        "typecheck"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "nx-release-publish": {
      "options": {
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "affected": {
    "legacy": true
  }
}
