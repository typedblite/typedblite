{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out",
    "paths": {
      "@typedblite/language": [
        "../language/out/index.d.ts"
      ],
      "@typedblite/content-revision": [
        "../content-revision/out/index.d.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../language/tsconfig.src.json"
    },
    {
      "path": "../content-revision/tsconfig.src.json"
    }
  ]
}
