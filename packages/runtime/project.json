{
  "name": "typedblite-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/runtime/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc -b tsconfig.src.json",
        "cwd": "packages/runtime"
      },
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "packages/runtime"
      }
    },
    "test-oracle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.oracle.config.ts",
        "cwd": "packages/runtime"
      }
    }
  }
}
