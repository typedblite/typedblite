{
  "name": "@typedblite/workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.16"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "gate": "node tools/gate.mjs",
    "playground": "nx run playground:serve",
    "site": "nx run website:serve",
    "deploy:site": "nx run website:check && cd apps/website && npx --yes cf@latest deploy ./dist",
    "check-packages": "node tools/check-packages.mjs",
    "clean-room": "node tools/clean-room.mjs",
    "tour": "node tools/tour.mjs",
    "check-api": "node tools/check-api.mjs",
    "docs:api": "typedoc --out dist/api"
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "nx": "24.0.6",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@swc/core@1.15.47": true,
    "nx@24.0.6": true,
    "esbuild@0.28.2": true,
    "electron@42.11.18": true
  }
}
