# Documents attached to a project: the schema the full-text search tests use.
#
# Written for TypeDBLite's own tests. It has no relations: a relation with no `@key` has no identity two
# stores agree on, so it does not replicate, and these documents must.
#
# One attribute name matters to search: the full-text index puts an attribute named `tag`, or ending in
# `-tag`, into its `tags` column, and every attribute's value into `text` (`full-text.ts`). Renaming `doc-tag`
# changes what a `tags:` filter finds.
#
# `doc-facet` and `doc-tag` are owned without `@card`, and a document holds several of each.
define

attribute doc-id, value string;
attribute doc-title, value string;
attribute doc-kind, value string;
attribute doc-path, value string;
attribute doc-body, value string;
attribute doc-facet, value string;
attribute doc-tag, value string;

entity document,
    owns doc-id @key,
    owns doc-title,
    owns doc-kind,
    owns doc-path,
    owns doc-body,
    owns doc-facet,
    owns doc-tag;
