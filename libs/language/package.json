{
  "name": "@typedblite/language",
  "description": "TypeQLite grammar, AST, language services and SQLite generator",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "keywords": [
    "typedblite",
    "typeqlite",
    "typeql",
    "typedb",
    "langium",
    "grammar",
    "language-server",
    "parser"
  ],
  "homepage": "https://github.com/typedblite/typedblite/tree/main/libs/language#readme",
  "bugs": {
    "url": "https://github.com/typedblite/typedblite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typedblite/typedblite.git",
    "directory": "libs/language"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "out",
    "src",
    "syntaxes"
  ],
  "main": "./out/index.js",
  "module": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./typeqlite.tmLanguage.json": "./syntaxes/typeqlite.tmLanguage.json"
  },
  "typesVersions": {
    "*": {
      ".": [
        "out/index"
      ]
    }
  },
  "scripts": {
    "langium:generate": "langium generate && tsx scripts/generate-textmate.mts",
    "build": "tsc -b tsconfig.src.json"
  },
  "dependencies": {
    "langium": "~4.4.2",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "langium-cli": "~4.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
