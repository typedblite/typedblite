{
  "name": "@typedblite/language",
  "description": "TypeQLite grammar, AST, language services and SQLite generator",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.2.3"
  },
  "files": [
    "out",
    "src"
  ],
  "main": "./out/index.js",
  "module": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "out/index"
      ]
    }
  },
  "scripts": {
    "langium:generate": "langium generate && tsx scripts/generate-textmate.mts",
    "build": "tsc -b tsconfig.src.json"
  },
  "dependencies": {
    "langium": "~4.4.2",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "langium-cli": "~4.4.1"
  }
}
