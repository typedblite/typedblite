{
  "name": "@typedblite/content-revision",
  "description": "Canonical state encoding and ADR-003 D3 generation-digest revisions, shared by TypeDBLite's change log and any application that versions content the same way",
  "version": "0.1.0-rc.1",
  "license": "MPL-2.0",
  "keywords": [
    "typedblite",
    "revision",
    "content-addressed",
    "canonical-json",
    "change-log",
    "replication"
  ],
  "homepage": "https://github.com/typedblite/typedblite/tree/main/libs/content-revision#readme",
  "bugs": {
    "url": "https://github.com/typedblite/typedblite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typedblite/typedblite.git",
    "directory": "libs/content-revision"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "out",
    "src",
    "!src/**/*.spec.ts"
  ],
  "main": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
