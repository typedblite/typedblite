{
  "name": "@typedblite/runtime",
  "description": "The TypeDBLite engine: TypeQLite on SQLite, with a change log, replication and full-text search",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "keywords": [
    "typedblite",
    "typeqlite",
    "typeql",
    "typedb",
    "sqlite",
    "graph",
    "database",
    "embedded",
    "replication",
    "offline-first",
    "full-text-search",
    "wasm"
  ],
  "homepage": "https://github.com/dave-jackson-dev/typedblite/tree/main/libs/runtime#readme",
  "bugs": {
    "url": "https://github.com/dave-jackson-dev/typedblite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dave-jackson-dev/typedblite.git",
    "directory": "libs/runtime"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "out",
    "src"
  ],
  "main": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "browser": {
        "types": "./out/index.browser.d.ts",
        "default": "./out/index.browser.js"
      },
      "default": "./out/index.js"
    },
    "./wasm": {
      "types": "./out/wasm.d.ts",
      "default": "./out/wasm.js"
    }
  },
  "dependencies": {
    "@typedblite/content-revision": "0.0.1",
    "@typedblite/language": "0.0.1",
    "langium": "~4.4.2",
    "vscode-languageserver": "~10.1.0"
  },
  "imports": {
    "#default-opener": {
      "types": "./out/default-opener.d.ts",
      "node": "./out/default-opener.node.js",
      "default": "./out/default-opener.js"
    }
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "playwright-core": "1.65.0"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": ">=3.54.1-build1 <3.54.2"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
