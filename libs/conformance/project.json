{
  "name": "typedblite-conformance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/conformance/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc -b tsconfig.src.json",
        "cwd": "libs/conformance"
      },
      "outputs": [
        "{projectRoot}/out"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "^build"
      ],
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "libs/conformance"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc -p tsconfig.src.json --noEmit",
        "cwd": "libs/conformance"
      }
    },
    "report": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsx src/cli.ts",
        "cwd": "libs/conformance"
      }
    }
  }
}
