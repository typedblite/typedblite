{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "importHelpers": false
  },
  "include": ["libs/runtime/src/**/*.ts", "libs/language/src/**/*.ts", "libs/content-revision/src/**/*.ts", "libs/session/src/**/*.ts", "libs/node-host/src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
